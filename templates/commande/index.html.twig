{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<main>
    <h1>Mes commandes</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Montant</th>
                <th>Status</th>
                <th>Détails</th>
            </tr>
        </thead>
        <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.id }}</td>
                <td>{{ commande.dateCommande ? commande.dateCommande|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ (commande.montantTotalCentimes / 100)|number_format(2, ',', ' ') }} €</td>
                <td>{{ commande.status }}</td>
                <td>
                    <a href="{{ path('app_commande_show', {'id': commande.id}) }}">show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Vous n’avez encore passé aucune commande.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_client') }}" class="btn btn-secondary">
        Retour au tableau de bord
    </a>
</main>
{% endblock %}
