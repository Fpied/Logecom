{% extends 'base.html.twig' %}

{% block title %}Commande{% endblock %}

{% block body %}
<main>
    <h1>Commande</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Date de commande</th>
                <td>{{ commande.dateCommande ? commande.dateCommande|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Montant</th>
                <td>{{ (commande.montantTotalCentimes / 100)|number_format(2, ",", '')}} €</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ commande.status }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_commande_index') }}">Retour à la liste</a>


    {{ include('commande/_delete_form.html.twig') }}
</main>
{% endblock %}
