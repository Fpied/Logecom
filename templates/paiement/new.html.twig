{% extends 'base.html.twig' %}

{% block title %}Choix du paiement{% endblock %}

{% block body %}
<div class="page">
    <main class="cart-page">

        <h1>Choisissez votre moyen de paiement</h1>

        <p>
            Sélectionnez le moyen de paiement que vous souhaitez utiliser.
        </p>

        <form
        method="post"
        action="{{ path('app_commande_paiement') }}"
        class="payment-form"
        data-turbo="false"
        >
            <label class="payment-option">
                <input
                    type="radio"
                    name="payment_method"
                    value="stripe"
                    checked
                    required
                >

                <span>Carte bancaire</span>
            </label>

            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('choose_payment_method') }}"
            >

            <button
                type="submit"
                class="cart-button payment-submit"
            >
                Payer par carte
            </button>
        </form>

        <div class="cart-actions">
            <a
                href="{{ path('app_commande_adresse') }}"
                class="view-button"
            >
                Retour à l’adresse
            </a>
        </div>

    </main>
</div>
{% endblock %}
