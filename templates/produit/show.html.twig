{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}
<main>
    <h1>Produit</h1>

    {% if produit.images|length > 0 %}
    {% set image = produit.images|first %}

    <div class="produit-show-image">
        <img
            src="{{ asset('uploads/images/' ~ image.url) }}"
            alt="{{ produit.title }}"
            class="produit-image"
            style="width: 300px; height: 300px; object-fit: contain; display: block; margin: 20px auto;"
        >
        </div>
    {% else %}
        <p>Aucune image pour ce produit.</p>
    {% endif %}

    <table class="table">
        <tbody>
            <tr>
                <th>Titre</th>
                <td>{{ produit.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ produit.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ (produit.centPrice / 100)|number_format(2, ',', ' ') }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ produit.stock }}</td>
            </tr>
            <tr>
                <th>Etat</th>
                <td>{{ produit.state }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ produit.actif ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    
    {% if produit.actif and produit.stock > 0 %}
        <form
            action="{{ path('app_panier_ajouter', {'id': produit.id}) }}"
            method="post"
        >
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('ajouter-panier-' ~ produit.id) }}"
            >

            <button type="submit" class="cart-button button-produit">
                Ajouter au panier
            </button>
        </form>
    {% else %}
        <p>Produit indisponible.</p>
    {% endif %}
    

    <a href="{{ path('home') }}">Retour à la liste des produits</a>


    {{ include('produit/_delete_form.html.twig') }}
</main>
{% endblock %}
