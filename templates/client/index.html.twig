{% extends 'base.html.twig' %}

{% block title %}Mon espace vendeur{% endblock %}

{% block body %}
<main class="seller-dashboard">

    <h2>Tableau de bord</h2>

    <p class="text-success">
        Achats: {{ (totalAchatsCentimes / 100)|number_format(2, ',', ' ')}}€
    </p>
    <p class="text-danger">
        ventes: {{ (totalVentesCentimes / 100)|number_format(2, ',', ' ')}}€
    </p>

    <div class="dashboard-actions">

        <a href="{{ path('app_commande_index')}}" class="dashboard-button">
            Mes commandes
        </a>

        <a href="{{ path('app_produit_index')}}" class="dashboard-button">
            Mes produits en vente
        </a>

        <a href="{{ path('app_produit_new')}}" class="dashboard-button">
            Mettre un produit en vente
        </a>

        <a href="{{ path('app_utilisateur_edit', { id: utilisateur.id })}}" class="dashboard-button">
            Modifier Profil
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin') }}" class="view-button">
                Administration
            </a>
        {% endif %}


        <a href="{{ path('app_logout') }}" class="view-button">
            Déconnexion
        </a>
    </div>

    


                

</main>
{% endblock %}
