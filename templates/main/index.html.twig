{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="page">

    <main class="home-content">
    <aside class="cart">
    <h2>PANIER</h2>

        {% if lignesPanier is empty %}
            <p>Votre panier est vide.</p>
        {% else %}
            {% set totalPanier = 0 %}

            {# On parcourt toutes les lignes uniquement pour calculer le total complet #}
            {% for ligne in lignesPanier %}
                {% set totalPanier =
                    totalPanier
                    + (ligne.produit.centPrice * ligne.quantite)
                %}
            {% endfor %}

            {# On affiche seulement deux lignes du panier #}
            {% for ligne in lignesPanier|slice(0, 2) %}
                <div class="cart-item">
                    <p>{{ ligne.produit.title }}</p>

                    <p>
                        {{ (
                            (ligne.produit.centPrice * ligne.quantite) / 100
                        )|number_format(2, ',', ' ') }} €
                    </p>
                </div>
            {% endfor %}

            {% if lignesPanier|length > 2 %}
                <p class="cart-more">
                    + {{ lignesPanier|length - 2 }} autre(s) produit(s)
                </p>
            {% endif %}

            <hr>

            <p class="cart-total">
                <strong>Total :</strong>
                {{ (totalPanier / 100)|number_format(2, ',', ' ') }} €
            </p>
        {% endif %}
    </aside>

        <section class="featured-product">
            <h2>PRODUIT MIS EN AVANT</h2>

            {% if produits is not empty %}

                <div class="products-grid">

                    {% for produit in produits %}
                        <article class="product-card">
                            
                            <div class="product-image">
                                {% set imagePrincipale = null %}

                                {% for image in produit.images %}
                                    {% if image.mainImage %}
                                        {% set imagePrincipale = image %}
                                    {% endif %}
                                {% endfor %}

                                {% if imagePrincipale %}
                                    <img src="{{ asset('uploads/images/' ~ imagePrincipale.url) }}" alt="{{ produit.title }}">
                                {% else %}
                                    <div class="product-image-placeholder">
                                        Aucune image
                                    </div>
                                {% endif %}
                            </div>

                            <div class="product-card-content">
                                <h3>{{ produit.title }}</h3>

                                <p class="product-description">
                                    {{ produit.description|slice(0, 120) }}
                                    {% if produit.description|length> 120 %}...{% endif %}
                                </p>

                                <p class="product-price">
                                    {{ (produit.centPrice / 100 )|number_format(2, ',', ' ') }} €
                                </p>

                                <p class="product-stock">
                                    {% if produit.stock > 0 %}
                                        {{ produit.stock }} disponible(s)
                                    {% else %}
                                        Rupture de stock
                                    {% endif %}
                                </p>

                                <div class="product-actions">
                                    <a
                                        class="view-button"
                                        href="{{ path('app_produit_show', { id: produit.id }) }}"
                                    >
                                        Voir le produit
                                    </a>

                                    {% if produit.stock > 0 %}
                                        {% if app.user %}
                                            <form
                                                action="{{ path('app_panier_ajouter', {'id': produit.id}) }}"
                                                method="post"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('ajouter-panier-' ~ produit.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="cart-button"
                                                >
                                                    Ajouter au panier
                                                </button>
                                            </form>
                                        {% else %}
                                            <a
                                                class="cart-button"
                                                href="{{ path('app_login') }}"
                                            >
                                                Connectez-vous pour acheter
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            
            {% else %}
                <p>Aucun produit disponible pour le moment.</p>
            {% endif %}
        </section>
        
        
    </main>
</div>
{% endblock %}
