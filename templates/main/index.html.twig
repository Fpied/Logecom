{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="page">

    <main class="home-content">
    
        <section class="featured-product" data-controller="product-search">
            <h2>PRODUIT MIS EN AVANT</h2>

            {% if produits is not empty %}

            <div class="search-bar">
                <input class="input__search" type="text" id='product-search' placeholder="Rechercher un produit ..." data-product-search-target="input" data-action="input->product-search#search">
                <button class="button__search cart-button" type="button" data-action="click->product-search#search">Rechercher</button>
            </div>


                <div class="products-grid" data-product-search-target="grid">

                    {% for produit in produits %}
                        <article class="product-card" data-name="{{ produit.title|lower }}">
                            
                            <div class="product-image">
                                {% set imagePrincipale = null %}

                                {% for image in produit.images %}
                                    {% if image.mainImage %}
                                        {% set imagePrincipale = image %}
                                    {% endif %}
                                {% endfor %}

                                {% if imagePrincipale %}
                                    <img src="{{ asset('uploads/images/' ~ imagePrincipale.url) }}" alt="{{ produit.title }}">
                                {% else %}
                                    <div class="product-image-placeholder">
                                        Aucune image
                                    </div>
                                {% endif %}
                            </div>

                            <div class="product-card-content">
                                <h3>{{ produit.title }}</h3>

                                <p class="product-description">
                                    {{ produit.description|slice(0, 120) }}
                                    {% if produit.description|length> 120 %}...{% endif %}
                                </p>

                                <p class="product-price">
                                    {{ (produit.centPrice / 100 )|number_format(2, ',', ' ') }} €
                                </p>

                                <p class="product-stock">
                                    {% if produit.stock > 0 %}
                                        {{ produit.stock }} disponible(s)
                                    {% else %}
                                        Rupture de stock
                                    {% endif %}
                                </p>

                                <div class="product-actions">
                                    <a
                                        class="view-button"
                                        href="{{ path('app_produit_show', { id: produit.id }) }}"
                                    >
                                        Voir le produit
                                    </a>

                                    {% if produit.stock > 0 %}
                                        <form
                                            action="{{ path('app_panier_ajouter', {'id': produit.id}) }}"
                                            method="post"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('ajouter-panier-' ~ produit.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="cart-button"
                                            >
                                                Ajouter au panier
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <div class="pagination" id="pagination-controls" data-product-search-target="pagination"></div>
            
            {% else %}
                <p>Aucun produit disponible pour le moment.</p>
            {% endif %}
        </section>
        
        
    </main>
</div>
{% endblock %}
